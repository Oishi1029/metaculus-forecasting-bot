# ---- REQUIRED ----------------------------------------------------------------
# Metaculus -> Settings -> My Forecasting Bots -> Create a Bot -> copy the API key.
# The Metaculus API returns HTTP 403 to unauthenticated clients, so nothing runs
# without this.
METACULUS_TOKEN=

# One LLM key. OpenRouter is recommended because it reaches OpenAI, Anthropic,
# Google AND Perplexity through a single key, which is how the bot gets model and
# search diversity without extra accounts.
OPENROUTER_API_KEY=

# ---- OPTIONAL: each one adds a research source, none are required -------------
# AskNews (free tier for tournament entrants: 1,000 calls/month, 4,000 total).
# NOTE the two-key form. The Metaculus resources page calls it ASKNEWS_API_KEY,
# but the working template uses these two names.
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=
EXA_API_KEY=

# ---- OPTIONAL: behaviour ------------------------------------------------------
# Which tournament to forecast. Slug or numeric id.
#   minibench           the current MiniBench round (slug is deliberately stable)
#   market-pulse-26q3   $7,500, bot-eligible, forecasting to 2026-09-16
#   bot-testing-area    unscored sandbox -- the ONLY legal place to iterate
#   33022               Summer 2026 FutureEval
TOURNAMENT_ID=minibench

# competition (3 models) or shakeout (2 cheap models)
PROFILE=competition

# Set to 0 to run the full pipeline without publishing anything.
PUBLISH=1

# Costs 5 AskNews quota units per call instead of 1. Off by default.
ASKNEWS_USE_ARCHIVE=0
